{
  "name": "@blobby/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/client.js",
  "types": "src/client.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "latest",
    "@prisma/client": "latest",
    "pg": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "latest",
    "typescript": "latest"
  },
  "exports": {
    ".": {
      "types": "./src/client.ts",
      "import": "./dist/client.js"
    }
  }
}
