{
  "name": "@blobby/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "cors": "latest",
    "dotenv": "latest",
    "ethers": "latest",
    "express": "latest",
    "helmet": "latest",
    "pino": "latest",
    "pino-http": "latest",
    "zod": "latest",
    "@blobby/database": "0.1.0"
  },
  "devDependencies": {
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "prisma": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
