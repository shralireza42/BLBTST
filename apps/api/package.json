    "@nestjs/platform-express": "^11.1.21",
    "@nestjs/throttler": "^6.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cors": "latest",
    "dotenv": "latest",
    "ethers": "latest",
    "express": "latest",
    "helmet": "latest",
    "pino": "latest",
    "pino-http": "latest",
    "reflect-metadata": "^0.2.2",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "prisma": "latest",
