NODE_ENV=production
LOG_LEVEL=info

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
REDIS_URL=rediss://default:PASSWORD@HOST:6379
JWT_SECRET=

BSC_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/
BSC_CHAIN_ID=97
DAILY_DRAW_ADDRESS=0x0000000000000000000000000000000000000000
DAILY_DRAW_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
JACKPOT_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
JACKPOT_VAULT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
PRICE_ADAPTER_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
TREASURY_ROUTER_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

CONTRACT_SYNC_START_BLOCK=0
CONTRACT_CONFIRMATION_DEPTH=12
EVENT_SYNC_CHUNK_SIZE=2000

# Keep true on free hosts until roles and top-up approvals are verified.
WORKER_DRY_RUN=true
WORKER_PRIVATE_KEY=
MAX_TOP_UP_WEI=0

ROUND_TIMEOUT_MONITOR_INTERVAL_MS=60000
ROUND_CLOSE_WORKER_INTERVAL_MS=30000
SETTLEMENT_MONITOR_INTERVAL_MS=60000
VRF_MONITOR_INTERVAL_MS=60000
JACKPOT_THRESHOLD_MONITOR_INTERVAL_MS=120000
ORACLE_HEALTH_MONITOR_INTERVAL_MS=60000
PRICE_SNAPSHOT_INTERVAL_MS=300000
AUDIT_EXPORT_INTERVAL_MS=600000
