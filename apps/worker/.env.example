NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://blobby:blobby@localhost:5432/blobby

BSC_RPC_URL=https://bsc-dataseed.binance.org/
BSC_CHAIN_ID=56
DAILY_DRAW_ADDRESS=0x0000000000000000000000000000000000000000
JACKPOT_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
DEPLOY_BLOCK=0
CONTRACT_SYNC_START_BLOCK=0
CONTRACT_CONFIRMATION_DEPTH=12

# Wallet must have OPERATOR_ROLE and TOP_UP_ROLE where relevant.
WORKER_PRIVATE_KEY=

POLL_INTERVAL_MS=30000
EVENT_SYNC_CHUNK_SIZE=2000
AUTO_OPEN_ROUND=true

# Wei-denominated BLOBBIE max per automated top-up transaction.
MAX_TOP_UP_WEI=0
